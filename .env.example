# =============================================================================
# SMART on FHIR Configuration
# =============================================================================

# SMART Client ID (optional, defaults to "my_web_app"). This is a PUBLIC
# registered client identifier, not a secret. The app uses public client +
# PKCE only — there is no client-secret / confidential-client mode (a static
# front end can't keep a secret).
NEXT_PUBLIC_SMART_CLIENT_ID=my_web_app

# Additional trusted SMART issuer origins, comma-separated. Unknown issuers are
# still usable, but the app shows an explicit confirmation screen first.
NEXT_PUBLIC_SMART_ALLOWED_ISS=

# =============================================================================
# Deployment Configuration
# =============================================================================

# Set to "true" when deploying to GitHub Pages
GITHUB_PAGES=

# Base path for GitHub Pages deployment
NEXT_PUBLIC_BASE_PATH=/medical-note-smart-on-fhir

# Alternative static-export base path (for example /app on mediprisma.tw).
# Leave blank for normal dev / Node hosting. build:mediprisma sets this itself.
DEPLOY_BASE_PATH=

# =============================================================================
# Self-hosted Google sign-in and PostgreSQL document store
# =============================================================================
# App sign-in uses Google OIDC handled by this Next.js server, not Firebase Auth.
# APP_BASE_URL must be the public origin (production: HTTPS, no path). Register
# <APP_BASE_URL>/api/auth/google/callback as the Google OAuth redirect URI.
APP_BASE_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
# Optional override; normally derived from APP_BASE_URL.
GOOGLE_OAUTH_REDIRECT_URI=
# Local/dev fallbacks only. In production, store these values in OpenBao instead.
GOOGLE_CLIENT_SECRET=
DATABASE_URL=
# OpenBao KV v2 references: mount/path/field (see openbao/README.md).
OPENBAO_GOOGLE_CLIENT_SECRET_PATH=kv/apps/mediprisma/auth/google-client-secret
OPENBAO_DATABASE_URL_PATH=kv/apps/mediprisma/database/url
PG_POOL_MAX=10

# =============================================================================
# API Keys and Proxy Configuration
# =============================================================================
# Local dev should point the six *_URL vars at the dev-* function group
# (e.g. https://dev-proxychatcompletion-....run.app) — its CORS only allows
# localhost:3001, so prod stays isolated. Production URLs (un-prefixed) are
# injected from GitHub secrets by the CI/gh-pages workflows.

# Chat API endpoint
NEXT_PUBLIC_CHAT_URL=

# Whisper API endpoint for speech-to-text
NEXT_PUBLIC_WHISPER_URL=

# Gemini API endpoint
NEXT_PUBLIC_GEMINI_URL=
NEXT_PUBLIC_CLAUDE_URL=

# Optional BYO OpenAI-compatible Firebase Gateway. Unlike direct mode, prompts,
# responses, endpoint metadata, and the user's upstream key transit Firebase.
NEXT_PUBLIC_OPENAI_COMPATIBLE_GATEWAY_URL=

# Hospital drug-interaction service origin (no trailing slash). The 用藥 card
# shows 交互作用 only when this is set and the service answers; only
# ingredient names are sent. Blank keeps the section off.
NEXT_PUBLIC_DDI_SERVICE_ORIGIN=

# Optional public client marker for compatible legacy proxy integrations.
# This value is visible to browsers and must never be treated as a secret or
# the only authentication check; self-hosted /api/ai requires an app session.
NEXT_PUBLIC_PROXY_KEY=

# Abort an AI stream after this many milliseconds without a new token/event.
# Defaults to 60000 when blank or invalid.
NEXT_PUBLIC_STREAM_IDLE_TIMEOUT_MS=60000

# =============================================================================
# Optional Firebase-backed integrations (not app sign-in / document storage)
# =============================================================================
# The self-hosted Google OIDC login and PostgreSQL document store do not use
# Firebase Auth or Firestore. These public settings remain available only for
# optional existing Functions, App Check, analytics, or external integrations.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase App Check (reCAPTCHA v3) for proxy anti-abuse. The debug token is
# local/headless development only and must never be injected into production.
NEXT_PUBLIC_APPCHECK_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_APPCHECK_DEBUG=

# E2E only: routes optional Firebase SDK Auth and Firestore to local emulators when exactly "1".
# This does not change the app's self-hosted Google OIDC session.
NEXT_PUBLIC_FIREBASE_EMULATOR=

# =============================================================================
# Additional Services
# =============================================================================

# Perplexity API proxy URL
NEXT_PUBLIC_PERPLEXITY_PROXY_URL=

# Feedback service URL (production: Firebase Function endpoint)
NEXT_PUBLIC_FEEDBACK_URL=

# Lab-data problem report (回報檢驗資料問題) Function. Optional: when blank it
# is derived from NEXT_PUBLIC_FEEDBACK_URL (…sendfeedback-<hash>… →
# …submitlabdatareport-<hash>…, dev- prefix kept). Set it for the emulator,
# e.g. http://127.0.0.1:5001/demo-mediprisma/us-central1/dev-submitLabDataReport
NEXT_PUBLIC_LAB_DATA_REPORT_URL=

# The hospital Gateway that receives a lab-data report sent 團隊和機構 or 僅機構
# (offered on ?site=vghtpe only). Leave blank until the Gateway route exists:
# blank means the institution is never contacted. HTTPS only (plain HTTP on
# loopback), a full endpoint URL with no credentials, query or fragment.
NEXT_PUBLIC_LAB_REPORT_INSTITUTION_URL=

# --- Dev / self-host only: the built-in Next API route at /api/feedback ---
# These power the local fallback feedback route (next dev / a Node host).
# They are NOT used by the static GitHub Pages build. Leave blank to have
# the route accept feedback without sending email.
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=

# HF SaMD: unset policy retains Firebase; intranet requires approved HTTPS ingress.
# NEXT_PUBLIC_HF_GATEWAY_ORIGIN=https://samd.mediprisma.tw
# NEXT_PUBLIC_HF_AUTH_POLICY=intranet

# =============================================================================
# Self-hosted AI Service (OpenAI-compatible) — 自架 AI 服務介接層
# =============================================================================
# 啟用自架 AI 服務：設定上游模型名稱即生效（瀏覽器只認同源代理 /api/ai）。
NEXT_PUBLIC_AI_SELF_MODEL=
# 瀏覽器呼叫端點（預設同源代理 /api/ai；也可設絕對 URL 直連）
NEXT_PUBLIC_AI_SELF_ENDPOINT=
# 可選的公開閘道配對值（會送至瀏覽器，不是秘密）；與伺服器 AI_PROXY_KEY 配對。
# 留空只會略過額外閘道檢查；/api/ai 仍要求本專案登入 session。
NEXT_PUBLIC_AI_PROXY_KEY=
# Docker runtime 可使用 plain AI_SELF_PROXY_KEY（寫入 app-config.js，同樣公開）。
# AI_SELF_PROXY_KEY=
# 上游模型 context window（token 數）
NEXT_PUBLIC_AI_SELF_CONTEXT=

# ── 伺服器端（不加 NEXT_PUBLIC_；金鑰建議由 OpenBao 管理） ──
# 自架 AI 服務 base URL（OpenBao 對應 kv/apps/mediprisma/ai/base-url）
AI_SELF_BASE_URL=
# 自架 AI 服務 API 金鑰（OpenBao 對應 kv/apps/mediprisma/ai/api-key，自動輪換生效）
AI_SELF_API_KEY=
# /api/ai optional extra gate; session authentication is always required.
AI_PROXY_KEY=

# =============================================================================
# OpenBao（選填；設定後伺服器金鑰改由 OpenBao 讀取，支援自動輪換）
# =============================================================================
OPENBAO_ADDR=
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=
OPENBAO_RUNTIME_PATH=kv/apps/mediprisma/runtime

# =============================================================================
# Docker 執行期組態（compose environment）— 免重建映像
# =============================================================================
# 容器啟動時由 scripts/openbao/write-app-config.mjs 將下列公開 Firebase／AI
# 設定寫入 public/app-config.js（瀏覽器在任何 bundle 前同步讀取）；不含 Google
# OIDC server 設定。APP_BASE_URL、GOOGLE_CLIENT_ID、OPENBAO_*、PG_POOL_MAX
# 由 Node server 環境讀取；自架登入與 /api/data 需要 PostgreSQL。
#   FIREBASE_API_KEY / FIREBASE_AUTH_DOMAIN / FIREBASE_PROJECT_ID /
#   FIREBASE_STORAGE_BUCKET / FIREBASE_MESSAGING_SENDER_ID / FIREBASE_APP_ID /
#   FIREBASE_MEASUREMENT_ID / FIREBASE_APPCHECK_SITE_KEY
#   AI_SELF_MODEL / AI_SELF_ENDPOINT / AI_SELF_PROXY_KEY / AI_SELF_CONTEXT
