# ─── 健康存摺儀表板 — 後端環境變數 ────────────────────────────────────────────
# 複製此檔案為 .env，依需要填入各項設定
# cp server/.env.example server/.env

# ── 必要安全設定 ──────────────────────────────────────────────────────────────

# JWT 簽名金鑰（強烈建議設定，勿使用預設值）
# 生成指令：openssl rand -hex 32
JWT_SECRET=

# ── 加密金鑰 ──────────────────────────────────────────────────────────────────

# AES-256-GCM 主加密金鑰（64 個 hex 字元 = 32 bytes）
# 若不設定，伺服器啟動時自動生成並儲存至 server/data/.key
# ⚠️  若使用 .key 檔案，務必將 server/data/ 整個目錄一起備份
# 生成指令：openssl rand -hex 32
ENCRYPTION_KEY=

# ── Google SSO（選填）────────────────────────────────────────────────────────

# Google OAuth 2.0 用戶端 ID
# 申請：https://console.cloud.google.com/apis/credentials
# 不填則停用 Google 登入，僅使用帳號密碼登入
GOOGLE_CLIENT_ID=

# ── 伺服器設定 ────────────────────────────────────────────────────────────────

# 後端監聽埠號（預設 3001）
# PORT=3001

# 是否信任反向代理寫入的 X-Forwarded-For 標頭。
# 僅在部署於會覆寫此標頭的反向代理（nginx、Caddy…）之後時設為 true；
# 直接暴露伺服器時務必留空，否則攻擊者可偽造標頭繞過登入速率限制。
# 開發模式透過 Vite proxy 時可設為 true（localhost 環境安全）。
# TRUST_PROXY=true

# 管理員 IP 白名單（逗號分隔，可與管理介面設定的清單合併）。
# 設為空則不限制管理員來源 IP。
# ENV_ADMIN_IP_ALLOWLIST=203.0.113.10,2001:db8::1
